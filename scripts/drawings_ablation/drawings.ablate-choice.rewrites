// ABLATION of drawings.rewrites: the non-confluent "choice" rules (overlay
// assoc/comm, transform factoring, repeat-unroll, scale/translate interchange) are
// removed, leaving the contracting core (transform composition + trig folding) plus
// bidirectional angle normalization. Isolates what the choice rules contribute. On
// dials this ties live==at-start, so the choice rules are what create the default's
// live advantage; on nuts-bolts live still beats at-start here (the gap there comes
// from the core + cost-vs-abstraction mismatch, not the choice rules), so the
// live-vs-at-start story is domain-dependent rather than choice-rule-exclusive.

constant_folding: !integersarefloats

// ── contract core ──
t_id: (T ?p (M 1 0 0 0)) => ?p
t_compose_norot: (T (T ?p (M ?s1 ?r1 ?x1 ?y1)) (M ?s2 0 ?x2 ?y2)) => (T ?p (M (* ?s1 ?s2) ?r1 (+ ?x2 (* ?s2 ?x1)) (+ ?y2 (* ?s2 ?y1))))
rep_1: (repeat ?x 1 ?m) => ?x
add_id_r: (+ ?x 0) => ?x
add_id_l: (+ 0 ?x) => ?x
sub_id:   (- ?x 0) => ?x
mul_id_r: (* ?x 1) => ?x
mul_id_l: (* 1 ?x) => ?x
mul_zero_r: (* ?x 0) => 0
mul_zero_l: (* 0 ?x) => 0
div_id:   (/ ?x 1) => ?x

// ── general transform composition (rotation), now foldable via the trig rules below ──
t_compose: (T (T ?p (M ?s1 ?r1 ?x1 ?y1)) (M ?s2 ?r2 ?x2 ?y2)) => (T ?p (M (* ?s1 ?s2) (+ ?r1 ?r2) (+ ?x2 (* ?s2 (- (* (cos ?r2) ?x1) (* (sin ?r2) ?y1)))) (+ ?y2 (* ?s2 (+ (* (sin ?r2) ?x1) (* (cos ?r2) ?y1))))))

// ── trig of the angles that actually occur, so rotation composition folds [contract] ──
cos_0: (cos 0) => 1
sin_0: (sin 0) => 0
cos_halfpi: (cos (/ pi 2)) => 0
sin_halfpi: (sin (/ pi 2)) => 1
cos_pi: (cos pi) => -1
sin_pi: (sin pi) => 0
cos_qpi: (cos (/ pi 4)) => 0.7071067811865476
sin_qpi: (sin (/ pi 4)) => 0.7071067811865476

// ── angle normalisation so equal rotations share a representative ──
ang_q: (/ (* 2 pi) 4) <=> (/ pi 2)
ang_e: (/ (* 2 pi) 8) <=> (/ pi 4)
ang_h: (/ (* 2 pi) 2) <=> pi

