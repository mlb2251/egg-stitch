and_comm: (and ?x ?y) => (and ?y ?x)
and_assoc: (and (and ?a ?b) ?c) => (and ?a (and ?b ?c))
or_comm: (or ?x ?y) => (or ?y ?x)
or_assoc: (or (or ?a ?b) ?c) => (or ?a (or ?b ?c))
notnot: (not (not ?x)) => ?x
demorgan_and: (not (and ?a ?b)) <=> (or (not ?a) (not ?b))
demorgan_or: (not (or ?a ?b)) <=> (and (not ?a) (not ?b))
factor_or: (and (or ?a ?x) (or ?a ?y)) => (or ?a (and ?x ?y))
factor_and: (or (and ?a ?x) (and ?a ?y)) => (and ?a (or ?x ?y))
absorb_and: (and ?a (or ?a ?b)) => ?a
absorb_or: (or ?a (and ?a ?b)) => ?a
idem_and: (and ?a ?a) => ?a
idem_or: (or ?a ?a) => ?a
