// Contract set + bounded equivalence rules that add canonicalization power
// (esp. rotation alignment) WITHOUT the C-monoid explosion. No c_comm/c_assoc.

constant_folding: !integersarefloats

// ── contract core ──
t_id: (T ?p (M 1 0 0 0)) => ?p
rep_1: (repeat ?x 1 ?m) => ?x
add_id_r: (+ ?x 0) => ?x
add_id_l: (+ 0 ?x) => ?x
sub_id:   (- ?x 0) => ?x
mul_id_r: (* ?x 1) => ?x
mul_id_l: (* 1 ?x) => ?x
mul_zero_r: (* ?x 0) => 0
mul_zero_l: (* 0 ?x) => 0
div_id:   (/ ?x 1) => ?x

// ── general transform composition (rotation), now foldable via the trig rules below ──

// ── trig of the angles that actually occur, so rotation composition folds [contract] ──
cos_0: (cos 0) => 1
sin_0: (sin 0) => 0
cos_halfpi: (cos (/ pi 2)) => 0
sin_halfpi: (sin (/ pi 2)) => 1
cos_pi: (cos pi) => -1
sin_pi: (sin pi) => 0
cos_qpi: (cos (/ pi 4)) => 0.7071067811865476
sin_qpi: (sin (/ pi 4)) => 0.7071067811865476

// ── angle normalisation so equal rotations share a representative ──
ang_q: (/ (* 2 pi) 4) <=> (/ pi 2)
ang_e: (/ (* 2 pi) 8) <=> (/ pi 4)
ang_h: (/ (* 2 pi) 2) <=> pi


// ── non-confluent "choice" rules: two normal forms, best pick depends on the library ──
t_factor: (C (T ?a ?m) (T ?b ?m)) <=> (T (C ?a ?b) ?m)
rep_unroll_2: (repeat ?x 2 (M 1 0 ?tx ?ty)) <=> (C ?x (T ?x (M 1 0 ?tx ?ty)))
rep_unroll_3: (repeat ?x 3 (M 1 0 ?tx ?ty)) <=> (C (C ?x (T ?x (M 1 0 ?tx ?ty))) (T ?x (M 1 0 (* 2 ?tx) (* 2 ?ty))))

// ── more non-confluent choice rules ──
c_assoc: (C (C ?a ?b) ?c) <=> (C ?a (C ?b ?c))
c_comm: (C ?a ?b) <=> (C ?b ?a)
rep_unroll_rot_2: (repeat ?x 2 (M 1 ?r 0 0)) <=> (C ?x (T ?x (M 1 ?r 0 0)))
rep_unroll_rot_3: (repeat ?x 3 (M 1 ?r 0 0)) <=> (C (C ?x (T ?x (M 1 ?r 0 0))) (T ?x (M 1 (+ ?r ?r) 0 0)))
scale_trans_interchange: (T (T ?p (M 1 0 ?x ?y)) (M ?s 0 0 0)) <=> (T (T ?p (M ?s 0 0 0)) (M 1 0 (* ?x ?s) (* ?y ?s)))

// ── composition via a symbolic matmul (no arithmetic reduction) ──
// nested transforms collapse into one transform over a matrix product
mm_compose: (T (T ?x ?m1) ?m2) => (T ?x (matmul ?m1 ?m2))
// matmul monoid: identity I = (M 1 0 0 0), and associativity (regroup sequences)
mm_id_l: (matmul (M 1 0 0 0) ?m) => ?m
mm_id_r: (matmul ?m (M 1 0 0 0)) => ?m
mm_assoc: (matmul (matmul ?a ?b) ?c) <=> (matmul ?a (matmul ?b ?c))
