// Contracting-only subset of the affine-transform algebra: every rule shrinks the
// term and none commute/duplicate, so the e-graph stays small (no blow-up). This is
// the canonical-cost win from composition+folding without the search explosion that
// c_comm / c_assoc / t_factor / repeat-unroll / trig-t_compose cause.
// See drawings.algebra.rewrites for the full (explosive) set and semantics.

constant_folding: !integersarefloats

// identity transform is a no-op
t_id: (T ?p (M 1 0 0 0)) => ?p

// two nested transforms collapse to one (outer rotation zero: folds to a literal matrix)
t_compose_norot: (T (T ?p (M ?s1 ?r1 ?x1 ?y1)) (M ?s2 0 ?x2 ?y2)) => (T ?p (M (* ?s1 ?s2) ?r1 (+ ?x2 (* ?s2 ?x1)) (+ ?y2 (* ?s2 ?y1))))

// repeat once is identity
rep_1: (repeat ?x 1 ?m) => ?x

// arithmetic identities — clean up the +0 / *1 / *0 residue the composition rule
// leaves when one operand is a variable (the constant folder only folds literals)
add_id_r: (+ ?x 0) => ?x
add_id_l: (+ 0 ?x) => ?x
sub_id:   (- ?x 0) => ?x
mul_id_r: (* ?x 1) => ?x
mul_id_l: (* 1 ?x) => ?x
mul_zero_r: (* ?x 0) => 0
mul_zero_l: (* 0 ?x) => 0
div_id:   (/ ?x 1) => ?x
